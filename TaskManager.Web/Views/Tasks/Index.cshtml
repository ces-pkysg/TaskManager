@model TaskManager.Web.Models.PagedResultViewModel<TaskManager.Web.Models.TaskViewModel>

@{
    ViewData["Title"] = "Tareas";
}



<partial name="_AlertMessages" />


<h1>Tareas 
    <!--<a asp-action="Create" class="btn btn-sm btn-primary">Agregar</a> -->
</h1>

<p>Mostrando @Model.Items.Count() de @Model.TotalCount</p>


@*@<table class="table table-striped">
    <thead>*@

<table class="table table-striped table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Título</th>
            <th>Categoría</th>
            <th>Completada</th>
            <th>Step</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model.Items)
        {
            <tr>
                <td>@t.Id</td>
                <td>@t.Title</td>
                <td>@t.CategoryName</td>
                <td>@(t.IsCompleted ? "Sí" : "No")</td>
                <td>@t.Step</td>

                             
                <!--se envia dato como de un formulario-->
                <td>                                      
                    <a asp-controller="Tasks" asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-primary">Ver detalles</a><!--Boton detalles-->
                    <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-primary">Editar</a><!--boton de editar-->
                    <form asp-action="Delete" method="post" class="d-inline"> <!--boton de eliminar-->
                        <input type="hidden" name="id" value="@t.Id" />
                        <button type="submit" class="btn btn-danger btn-sm"
                                onclick="return confirm('¿Estás seguro de que deseas eliminar esta tarea?');">
                            Eliminar
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>




@*Calcula cuántas páginas existen en total*@
@{
    var totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
}

<nav>
    <ul class="pagination justify-content-center">

        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
            <a class="page-link"
               asp-action="Index"
               asp-route-page="@(Model.Page - 1)">
                Anterior
            </a>
        </li>

        <li class="page-item disabled">
            <span class="page-link">
                Página @Model.Page de @totalPages
            </span>
        </li>

        <li class="page-item @(Model.Page >= totalPages ? "disabled" : "")">
            <a class="page-link"
               asp-action="Index"
               asp-route-page="@(Model.Page + 1)">
                Siguiente
            </a>
        </li>

    </ul>
</nav>

<a asp-action="Create" class="btn btn-sm btn-primary">Agregar</a> 
