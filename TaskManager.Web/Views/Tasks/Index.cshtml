@model TaskManager.Web.Models.PagedResultViewModel<TaskManager.Web.Models.TaskViewModel>


@{
    ViewData["Title"] = "Tareas";
    <!-- Guardamos filtros que vienen en la URL-->
    var text = Context.Request.Query["Text"].ToString();
    var categoryName = Context.Request.Query["CategoryName"].ToString();
    var isCompleted = Context.Request.Query["IsCompleted"].ToString();
    var step = Context.Request.Query["Step"].ToString();
}



<partial name="_AlertMessages" />


<h1>
    Tareas
    <!--<a asp-action="Create" class="btn btn-sm btn-primary">Agregar</a> -->
</h1>


<!-- FORMULARIO DE BÚSQUEDA -->

<form id="filterForm" asp-action="Index" method="get" class="mb-4">

    <div class="row">
        <div class="col-3">
            <label>Texto</label>
            <input type="text" class="form-control" name="Text" value="@Context.Request.Query["Text"]" /> <!--Se quita atModel? . Text para que solo quede value="Text"-->
        </div>

        <div class="col-3">
            <label>Categoría</label>
            <input type="text" class="form-control" name="CategoryName" value="@Context.Request.Query["CategoryName"]" /> <!--Igual que en text value se quita el model-->
        </div>

        <div class="col-2">
            <label>Completado</label>
            <select name="IsCompleted" class="form-control">
                <option value="">--Todos--</option>
                <option value="true" selected="@(Context.Request.Query["IsCompleted"] == "true")">Sí</option> <!--Tambien se quita el model en is completed-->
                <option value="false" selected="@(Context.Request.Query["IsCompleted"] == "false")">No</option>
            </select>
        </div>

        <div class="col-2">
            <label>Step</label>
            <input type="number" class="form-control" name="Step" value="@Context.Request.Query["Step"]" /> <!--tambien se quita el model en value = Step-->
        </div>

        <div class="col-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Buscar</button>
        </div>
    </div>
</form>




<!------ LISTADO ------>

<p>Mostrando @Model.Items.Count() de @Model.TotalCount</p>


@*@<table class="table table-striped">
    <thead>*@

<table class="table table-striped table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Título</th>
            <th>Categoría</th>
            <th>Completada</th>
            <th>Step</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model.Items)
        {
            <tr>
                <td>@t.Id</td>
                <td>@t.Title</td>
                <td>@t.CategoryName</td>
                <td>@(t.IsCompleted ? "Sí" : "No")</td>
                <td>@t.Step</td>
                <td>

                    <!--se envia dato como de un formulario-->

                    <a asp-controller="Tasks" asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-primary">Ver detalles</a><!--Boton detalles-->
                    <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-primary">Editar</a><!--boton de editar-->
                    <form asp-action="Delete" method="post" class="d-inline">
                        <!--boton de eliminar-->
                        <input type="hidden" name="id" value="@t.Id" />
                        <button type="submit" class="btn btn-danger btn-sm"
                                onclick="return confirm('¿Estás seguro de que deseas eliminar esta tarea?');">
                            Eliminar
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>




<!-- PAGINACIÓN -->
@*Calcula cuántas páginas existen en total*@
@{
    var totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
}

<nav>
    <ul class="pagination justify-content-center">

        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
            <a class="page-link"
               asp-action="Index"
               asp-route-page="@(Model.Page - 1)"
               asp-route-text="@text"
               asp-route-categoryName="@categoryName"
               asp-route-isCompleted="@isCompleted"
               asp-route-step="@step">
                Anterior
            </a>
        </li>

        <li class="page-item disabled">
            <span class="page-link"
                  Página @Model.Page de @totalPages
            </span>
        </li>

        <li class="page-item @(Model.Page >= totalPages ? "disabled" : "")">
            <a class="page-link"
               asp-action="Index"
               asp-route-page="@(Model.Page + 1)"
               asp-route-text="@text"
               asp-route-categoryName="@categoryName"
               asp-route-isCompleted="@isCompleted"
               asp-route-step="@step">
                Siguiente
            </a>
        </li>

    </ul>
</nav>

<a asp-action="Create" class="btn btn-sm btn-primary">Agregar</a>



